{
	"name": "n8n-nodes-captchaai",
	"version": "1.0.4",
	"description": "Official CaptchaAI community node for n8n - solve reCAPTCHA, Turnstile, GeeTest v3, and many other CAPTCHA types inside your workflows.",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"captcha",
		"captchaai",
		"captcha solver",
		"recaptcha",
		"turnstile",
		"cloudflare",
		"geetest v3",
		"captchafox",
		"friendly captcha",
		"lemin",
		"automation"
	],
	"license": "MIT",
	"homepage": "https://captchaai.com/",
	"author": {
		"name": "captchaai-developers",
		"email": "dev@captchaai.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/CaptchaAI/n8n-nodes-captchaai.git"
	},
	"bugs": {
		"url": "https://github.com/CaptchaAI/n8n-nodes-captchaai/issues"
	},
	"engines": {
		"node": ">=22"
	},
	"main": "dist/nodes/CaptchaAi/CaptchaAi.node.js",
	"scripts": {
		"build": "tsup && gulp build:icons",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --config tests/vitest.config.ts",
		"test:watch": "vitest --config tests/vitest.config.ts",
		"format": "prettier nodes credentials tests --write",
		"lint": "eslint nodes credentials package.json",
		"lintfix": "eslint nodes credentials package.json --fix",
		"scan": "npm run build && node scripts/scan-local.mjs",
		"scan:published": "npx @n8n/scan-community-package n8n-nodes-captchaai",
		"prepublishOnly": "npm run build && npm test && eslint -c .eslintrc.prepublish.js nodes credentials package.json"
	},
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md",
		"LICENSE.md"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/CaptchaAiApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/CaptchaAi/CaptchaAi.node.js"
		]
	},
	"devDependencies": {
		"@n8n/scan-community-package": "^0.29.1",
		"@types/node": "^22.10.0",
		"@typescript-eslint/parser": "~8.32.0",
		"captchaai-javascript": "^1.0.0",
		"eslint": "^8.57.0",
		"eslint-plugin-n8n-nodes-base": "^1.16.3",
		"gulp": "^5.0.0",
		"n8n-workflow": "*",
		"prettier": "^3.5.3",
		"tsup": "^8.3.5",
		"typescript": "^5.8.2",
		"vitest": "^3.2.0"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
